class Solution {
    public boolean hasPathSum(TreeNode root, int targetSum) {
        if (root == null) {
            return false;
        }

        targetSum -= root.val;

        if (root.left == null && root.right == null) {
            return targetSum == 0;
        }

        return hasPathSum(root.left, targetSum) ||
               hasPathSum(root.right, targetSum);
    }
}

// Problem Statement
Given the root of a binary tree and an integer targetSum, return true if the tree has a root-to-leaf path such that the sum of all node values along that path equals targetSum.

A leaf node is a node that has no left or right child.//
