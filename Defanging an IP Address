class Solution {
    public String defangIPaddr(String address) {
        String result="";
        char temp='.';
        for(int i=0;i<address.length();i++){
            if(temp==address.charAt(i)){
                result=result+"[.]";
            }
            else{
                result=result+address.charAt(i);
            }
        }
    
        
        return result;
    }
