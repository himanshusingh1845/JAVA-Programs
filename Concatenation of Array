Approach

Find the length of nums and store it in n.

Create a new array ans of size 2 * n.

Iterate through nums using a loop.

Copy each element into two positions::--
     
ans[i] = nums[i]

ans[i + n] = nums[i]

Return ans.





















class Solution {
    public int[] getConcatenation(int[] nums) {
        int n = nums.length;
        int[] ans = new int[2 * n];

        for (int i = 0; i < n; i++) {
            ans[i] = nums[i];
            ans[i + n] = nums[i];
        }

        return ans;
    }
}
